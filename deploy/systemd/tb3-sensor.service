[Unit]
Description=TurtleBot3 LiDAR/camera ROS 2 sensor nodes and snapshot service
After=network-online.target

[Service]
Type=simple
User=ubuntu
Environment=ROS_DOMAIN_ID=30
ExecStart=/bin/bash -lc 'source /opt/ros/jazzy/setup.bash && source /home/ubuntu/tb3_distributed_ws/install/setup.bash && ros2 launch tb3_distributed_bringup sensor_pi.launch.py lds_model:=LDS-02 enable_camera:=true'
Restart=on-failure
RestartSec=2

[Install]
WantedBy=multi-user.target
