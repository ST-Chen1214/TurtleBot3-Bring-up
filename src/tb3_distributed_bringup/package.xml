<?xml version="1.0"?>
<package format="3">
  <name>tb3_distributed_bringup</name>
  <version>0.2.0</version>
  <description>Launch files for multi-Raspberry-Pi TurtleBot3 deployment and Gazebo simulation.</description>
  <maintainer email="maintainer@example.com">Steven Chen</maintainer>
  <license>Apache-2.0</license>
  <buildtool_depend>ament_python</buildtool_depend>
  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>tb3_distributed_core</exec_depend>
  <exec_depend>tb3_distributed_interfaces</exec_depend>
  <exec_depend>turtlebot3_bringup</exec_depend>
  <exec_depend>turtlebot3_node</exec_depend>
  <exec_depend>turtlebot3_description</exec_depend>
  <exec_depend>turtlebot3_gazebo</exec_depend>
  <exec_depend>v4l2_camera</exec_depend>
  <export><build_type>ament_python</build_type></export>
</package>
