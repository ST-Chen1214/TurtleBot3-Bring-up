<?xml version="1.0"?>
<package format="3">
  <name>tb3_distributed_core</name>
  <version>0.2.0</version>
  <description>Distributed teleoperation, safety, telemetry, camera snapshot, and external communication bridges for TurtleBot3.</description>
  <maintainer email="maintainer@example.com">Steven Chen</maintainer>
  <license>Apache-2.0</license>
  <buildtool_depend>ament_python</buildtool_depend>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>std_srvs</exec_depend>
  <exec_depend>cv_bridge</exec_depend>
  <exec_depend>tb3_distributed_interfaces</exec_depend>

  <test_depend>python3-pytest</test_depend>
  <export><build_type>ament_python</build_type></export>
</package>
